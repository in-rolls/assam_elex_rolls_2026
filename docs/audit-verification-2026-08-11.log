     1	"""Cutting box images out for a reader that runs somewhere else.
     2	
     3	Cloud Vision reads the state, and once it has, **nothing checks it**. There are no labels at
     4	this scale, so the only automatic error signal is two independent engines disagreeing --
     5	dots.ocr is the strongest second reader available and it fails differently, being pure OCR with
     6	no language prior where Vision has one.
     7	
     8	It cannot run the state: it reads per box, so 25 million inferences, which is months of free
     9	GPU quota for accuracy it already ties. On a sample it is minutes, and a sample is all a check
    10	needs. That means getting a few thousand box images to a machine with a GPU, which is what this
    11	module is for.
    12	
    13	**The filename is the key.** ``p13_pg4_r2c0.png`` is part 13, page 4, box row 2, column 0 --
    14	the same spelling ``dataset/eval`` uses and the same thing :data:`electors.resolution.KEY`
    15	parses. So a folder of crops and a JSON of readings need nothing else to be lined up against
    16	what Vision said about the same boxes; there is no separate manifest to fall out of step.
    17	"""
    18	
    19	from __future__ import annotations
    20	
    21	import re
    22	import subprocess
    23	import tempfile
    24	from dataclasses import dataclass
    25	from pathlib import Path
    26	from typing import Any, Dict, Iterator, List, Optional, Sequence, Tuple
    27	
    28	from PIL import Image
    29	
    30	from assam_rolls import render, schema
    31	
    32	from . import extract, grid, pages
    33	
    34	#: ``p13_pg4_r2c0`` for a whole box, ``p13_pg4_r2c0_b0`` for one line inside it -- the same
    35	#: spelling ``dataset/eval`` and :mod:`electors.resolution` use, with the band appended.
    36	NAME = re.compile(r"p(\d+)_pg(\d+)_r(\d+)c(\d+)(?:_b(\d+))?$")
    37	
    38	
    39	def name_for(part: int, page: int, row: int, column: int, band: Optional[int] = None) -> str:
    40	    stem = f"p{part}_pg{page}_r{row}c{column}"
    41	    return stem if band is None else f"{stem}_b{band}"
    42	
    43	
    44	def key_of(name: str) -> Optional[Tuple[int, int, int, int]]:
    45	    """``(part, page, row, column)`` from a crop's filename, or None.
    46	
    47	    The band is deliberately *not* part of the key: several bands belong to one elector, and
    48	    this is what joins them back to that one row.
    49	    """
    50	    found = NAME.match(Path(name).stem)
    51	    if not found:
    52	        return None
    53	    return tuple(int(g) for g in found.groups()[:4])  # type: ignore[return-value]
    54	
    55	
    56	def band_of(name: str) -> Optional[int]:
    57	    """Which line of the box a crop is, or None if it is the whole box."""
    58	    found = NAME.match(Path(name).stem)
    59	    if not found or found.group(5) is None:
    60	        return None
    61	    return int(found.group(5))
    62	
    63	
    64	#: How far past the ink a band crop reaches, as a fraction of the band's own height.
    65	#:
    66	#: ``grid.text_bands`` pads by a flat 5px, which is enough for tesseract and **not** enough to
    67	#: hand a line to a model on its own: at 400 dpi that clips the top of a tall matra and the tail
    68	#: of a descender. Cut at the bands as given, ``বিনয়`` lost the head of its ``ি`` and ``অৰ্জুন``
    69	#: lost its hanger -- read as a different name, with nothing to show anything had gone wrong.
    70	#:
    71	#: 0.45 recovers both. It is deliberately more than needed and then clamped, because the cost of
    72	#: too little is a wrong name and the cost of too much is nothing.
    73	BAND_PAD_FRACTION = 0.45
    74	
    75	
    76	def band_window(bands: Sequence[Tuple[int, int]], index: int, box: grid.Box) -> Tuple[int, int]:
    77	    """The crop rectangle for one band: padded generously, never into its neighbour.
    78	
    79	    Padding alone bleeds the next line into the crop -- at 0.45 the relation line arrives under
    80	    the name, and a model handed two lines may answer with either. Clamping each side to the
    81	    midpoint of the gap takes everything available and stops exactly where the neighbour's claim
    82	    begins.
    83	    """
    84	    top, bottom = bands[index]
    85	    pad = int((bottom - top) * BAND_PAD_FRACTION)
    86	    ceiling = box.top if index == 0 else (bands[index - 1][1] + top) // 2
    87	    floor = box.bottom if index == len(bands) - 1 else (bottom + bands[index + 1][0]) // 2
    88	    return max(ceiling, top - pad), min(floor, bottom + pad)
    89	
    90	
    91	@dataclass
    92	class Crop:
    93	    """One image and everything needed to put its reading back in the right row.
    94	
    95	    The GPU stage sees only a folder of PNGs; this is what the CPU stage must have written down
    96	    for the join to be reconstructable. The rectangle is here so any crop can be re-cut or
    97	    checked against the source without re-deriving the geometry, and the sha ties the row to
    98	    exact source bytes rather than to a filename that may be reissued.
    99	    """
   100	
   101	    part: int
   102	    page: int
   103	    row: int
   104	    column: int
   105	    path: Path
   106	    band: Optional[int] = None
   107	    left: int = 0
   108	    top: int = 0
   109	    right: int = 0
   110	    bottom: int = 0
   111	    ac_no: int = 0
   112	    section: str = ""
   113	    source_zip: str = ""
   114	    source_pdf: str = ""
   115	    pdf_sha256: str = ""
   116	
   117	    @property
   118	    def key(self) -> Tuple[int, int, int, int]:
   119	        """The elector this crop belongs to. Bands of one box share it."""
   120	        return (self.part, self.page, self.row, self.column)
   121	
   122	    @property
   123	    def name(self) -> str:
   124	        """The row's key: where the box is, never which file it landed in.
   125	
   126	        These were the same thing while every crop was its own PNG. Once tiles are packed many
   127	        to a composite they are not: every tile in ``composite000`` shared that stem, so 873
   128	        manifest rows keyed down to 3 and 870 electors disappeared between the stages without a
   129	        word. The position is unique by construction; the filename is not.
   130	        """
   131	        return name_for(self.part, self.page, self.row, self.column, self.band)
   132	
   133	    def as_row(self) -> Dict[str, Any]:
   134	        return {
   135	            "name": self.name,
   136	            # Which image the tile is in -- one composite holds hundreds.
   137	            "image": self.path.name,
   138	            "ac_no": self.ac_no,
   139	            "part_no": self.part,
   140	            "page_no": self.page,
   141	            "box_row": self.row,
   142	            "box_col": self.column,
   143	            "band": self.band,
   144	            "left": self.left,
   145	            "top": self.top,
   146	            "right": self.right,
   147	            "bottom": self.bottom,
   148	            "roll_section": self.section,
   149	            "source_zip": self.source_zip,
   150	            "source_pdf": self.source_pdf,
   151	            "pdf_sha256": self.pdf_sha256,
   152	        }
   153	
   154	
   155	def boxes_of(image: Image.Image, number: int) -> List[grid.Box]:
   156	    """The elector boxes on one page, or nothing if it is not an elector page."""
   157	    signature = pages.classify(image, number)
   158	    if not signature.is_elector:
   159	        return []
   160	    return grid.build(signature.h_rules, signature.v_rules)
   161	
   162	
   163	def export_part(
   164	    zip_path: Path,
   165	    pdf_name: str,
   166	    part_no: int,
   167	    out_dir: Path,
   168	    dpi: int = extract.DPI,
   169	    limit: Optional[int] = None,
   170	    bands: Optional[Sequence[int]] = None,
   171	) -> List[Crop]:
   172	    """Write one part's boxes -- or single lines inside them -- as PNGs named after their position.
   173	
   174	    Cropped to ``text_right`` rather than the box's full width: everything past it is the photo
   175	    placeholder, and it is the same region the pipeline reads. Sending the photo would change
   176	    what the reader is being asked.
   177	
   178	    ``bands`` selects lines instead of whole boxes -- ``(0,)`` is the name line alone, which is
   179	    84 vision tokens against the box's 420. That is the whole point of the split: the model is
   180	    wanted for the name, and showing it the borders, the photo panel and three lines of digits
   181	    costs five times as much prefill for nothing.
   182	
   183	    Boxes with no ink are skipped before anything is written -- a blank box at the end of a part
   184	    is the publisher's doing and there is nothing in it to read.
   185	    """
   186	    out_dir.mkdir(parents=True, exist_ok=True)
   187	    meta = schema.parse_source_filename(pdf_name) or {}
   188	    pdf_bytes = render.read_pdf_bytes(zip_path, pdf_name)
   189	    sha = render.sha256_bytes(pdf_bytes)
   190	    written: List[Crop] = []
   191	
   192	    def record(image, box, number, section, rect, band):
   193	        name = name_for(part_no, number, box.row, box.column, band)
   194	        target = out_dir / f"{name}.png"
   195	        image.crop(rect).save(target, format="PNG", optimize=True)
   196	        written.append(
   197	            Crop(
   198	                part=part_no,
   199	                page=number,
   200	                row=box.row,
   201	                column=box.column,
   202	                path=target,
   203	                band=band,
   204	                left=rect[0],
   205	                top=rect[1],
   206	                right=rect[2],
   207	                bottom=rect[3],
   208	                ac_no=meta.get("ac_no", 0),
   209	                section=section,
   210	                source_pdf=pdf_name,

