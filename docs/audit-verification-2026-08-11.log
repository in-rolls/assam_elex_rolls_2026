   124	def sex_against_published(
   125	    rows: Sequence[Dict[str, Any]], male: int, female: int, tolerance: float = 0.02
   126	) -> Check:
   127	    """The extracted male share against the published one.
   128	
   129	    Bounds **bias, not error**: symmetric misreads cancel and leave the ratio untouched, so this
   130	    can pass while a tenth of rows are wrong. It earns its place because the failure it does
   131	    catch is the one that destroys aggregate statistics -- an earlier version ran 44.2% male
   132	    against a published 50.8%, and only the ratio noticed.
