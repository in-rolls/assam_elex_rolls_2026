   151	
   152	def summary_from_vision(
   153	    part_dir: Path, api_key: str, annotate: Optional[Callable] = None
   154	) -> Optional[Any]:
   155	    """The closing totals for a part tesseract could not read, bought from Vision.
   156	
   157	    About a fifth of parts end up with no printed total, so a fifth of the dataset has **no
   158	    check on it at all** -- the rows are extracted and nothing says whether the right number of
   159	    them came out. The cause is not a hard page: it is that the closing row's description cell
   160	    wraps across four lines, and ``summary.parse`` wants a balancing triple on one line. The
   161	    numbers are there; tesseract reconstructs the line without them.
   162	
   163	    One image a part, on a fifth of parts: about $9 for the state, against $148 already spent on
   164	    the boxes. Cheap for taking validation from four parts in five to all of them.
   165	
   166	    The arithmetic still decides. A triple that does not balance is refused here exactly as it is
   167	    on the tesseract path, so a bought reading can no more replace a right answer with a
   168	    plausible wrong one than a free one could.
   169	    """
   170	    page = part_dir / "summary_page.png"
   171	    if not page.exists():
   172	        return None
   173	
   174	    from PIL import Image
   175	
   176	    from . import summary as summary_module
   177	
   178	    cached = cached_words(part_dir, page.name)
   179	    if cached is None:
   180	        with Image.open(page) as image:
   181	            image.load()
   182	            responses = (
   183	                annotate([image]) if annotate is not None else vision.annotate([image], api_key)
   184	            )
   185	        if not responses:
   186	            return None
   187	        cached = vision.words_from(responses[0])
   188	        save_words(part_dir, page.name, cached)
   189	
   190	    with Image.open(page) as image:
   191	        text = "\n".join(vision.grouped_lines(cached, 0, image.width))
   192	    found = summary_module.parse(text)
   193	    if not found:
   194	        return None
   195	    male, female, third, total = found
   196	    return summary_module.RollSummary(male=male, female=female, third=third, total=total, scale=1)
   197	
   198	
   199	def words_path(part_dir: Path, image: str) -> Path:
   200	    return part_dir / f"{Path(image).stem}.words.json"
   201	
   202	
   203	def save_words(part_dir: Path, image: str, found: Sequence[vision.Word]) -> None:
   204	    """Keep what Vision said, so saying it again never has to be bought twice.
   205	
   206	    Rows were the only thing kept, and rows are a *parse* of the answer rather than the answer.
   207	    Every improvement to the parser therefore cost the whole API bill again: the EPIC fix that
   208	    took well-formed reads from 62% to 99% would have meant re-buying every image in the state
   209	    to apply it. Words are the last point at which the money has been spent and no judgement has
   210	    yet been made, so they are what to keep.
   211	
   212	    About 6,000 words a composite, which is a megabyte or so -- next to nothing beside the
   213	    composite itself, and a tiny fraction of what re-reading it would cost.
   214	    """
   215	    temporary = words_path(part_dir, image).with_suffix(".json.tmp")
   216	    temporary.write_text(
   217	        json.dumps(
   218	            [[w.text, w.left, w.top, w.right, w.bottom] for w in found],
   219	            ensure_ascii=False,
   220	        ),
   221	        encoding="utf-8",
   222	    )
   223	    temporary.replace(words_path(part_dir, image))
   224	
   225	
   226	def cached_words(part_dir: Path, image: str) -> Optional[List[vision.Word]]:
   227	    """What Vision said last time, or None if this image has never been read."""
   228	    path = words_path(part_dir, image)
   229	    if not path.exists():
   230	        return None
   231	    return [
   232	        vision.Word(text, left, top, right, bottom)
   233	        for text, left, top, right, bottom in json.loads(path.read_text(encoding="utf-8"))
   234	    ]
   235	
   236	
   237	def ready(part_dir: Path) -> bool:
   238	    """Whether stage one left this part complete enough to read."""
   239	    return (
   240	        (part_dir / crops.MANIFEST).exists()
   241	        and (part_dir / "placements.json").exists()
   242	        and (part_dir / "side.json").exists()
   243	        and bool(composites(part_dir))
   244	    )

