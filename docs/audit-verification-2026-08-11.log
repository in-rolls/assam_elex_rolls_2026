   193	def judge(
   194	    ac_no: int,
   195	    rows: Sequence[Dict[str, Any]],
   196	    published_parts: int,
   197	    totals: Dict[int, int],
   198	    male: int = 0,
   199	    female: int = 0,
   200	    boxes_per_part: Optional[Dict[int, int]] = None,
   201	) -> Verdict:
   202	    """Every check, in one verdict."""
