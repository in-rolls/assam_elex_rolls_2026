    70	    try:
    71	        manifest = crops.read_manifest(part_dir)
    72	    except ValueError as exc:
    73	        check.note(str(exc))
    74	        return check
    75	    placements = json.loads((part_dir / "placements.json").read_text(encoding="utf-8"))
    76	
    77	    check.tiles = len(manifest)
    78	    check.placements = sum(len(v) for v in placements.values())
    79	    if check.tiles != check.placements:
    80	        check.note(f"{check.tiles} manifest rows against {check.placements} placements")
    81	
    82	    # Every placement must name a box the manifest knows, and each box exactly once.
    83	    seen: Dict[str, str] = {}
    84	    for image, tiles in placements.items():
    85	        for tile in tiles:
    86	            key = crops.name_for(part_no, tile["page"], tile["box_row"], tile["box_col"])
    87	            if key not in manifest:
    88	                check.note(f"{image} places {key}, which is not in the manifest")
    89	            elif key in seen:
    90	                check.note(f"{key} is placed twice: {seen[key]} and {image}")
    91	            else:
    92	                seen[key] = image
    93	    for key, row in manifest.items():
    94	        if key not in seen:
    95	            check.note(f"{key} is in the manifest but was never placed -- an elector lost")
    96	
    97	    # Inside one composite no two tiles may overlap: a word in the overlap belongs to both.
    98	    for image, tiles in placements.items():
    99	        for i, a in enumerate(tiles):
   100	            for b in tiles[i + 1 : i + 4]:  # sorted by position, so neighbours suffice
   101	                if _overlaps(a, b):
   102	                    check.note(f"{image}: tiles overlap at {_rect(a)} and {_rect(b)}")
   103	    return check
   104	
   105	
   106	def check_pixels(
   107	    zip_path: Path,
   108	    pdf_name: str,
   109	    part_dir: Path,
   110	    check: PartCheck,
   111	    sample: Optional[int] = 40,
   112	    dpi: int = extract.DPI,
   113	) -> PartCheck:
   114	    """Compare the composite against the source page, tile by tile.
   115	
   116	    The decisive test. If the crop taken from the composite is not the same bytes as the crop
   117	    taken from the page, the tile is either the wrong pixels or in the wrong place, and every row
   118	    derived from it is wrong in a way no downstream check would notice.
   119	    """
   120	    import tempfile
   121	
   122	    from PIL import Image
   123	
   124	    manifest = crops.read_manifest(part_dir)
   125	    placements = json.loads((part_dir / "placements.json").read_text(encoding="utf-8"))
   126	
   127	    wanted: Dict[int, List[Tuple[str, Dict[str, Any], Dict[str, Any]]]] = {}
   128	    for image, tiles in placements.items():
   129	        for tile in tiles:
   130	            key = crops.name_for(check.part_no, tile["page"], tile["box_row"], tile["box_col"])
   131	            if key in manifest:
   132	                wanted.setdefault(tile["page"], []).append((image, tile, manifest[key]))
   133	
   134	    chosen = _sample(wanted, sample)
   135	    if not chosen:
   136	        return check
   137	
   138	    opened: Dict[str, Any] = {}
   139	    pdf_bytes = render.read_pdf_bytes(zip_path, pdf_name)
   140	    with tempfile.TemporaryDirectory() as tmp:
   141	        images = vision_part.rasterize(dpi)(pdf_bytes, Path(tmp))
   142	        for page, rows in chosen.items():
   143	            if page > len(images):
   144	                check.note(f"page {page} is in the manifest but the part has {len(images)} pages")
   145	                continue
   146	            source = images[page - 1]
   147	            for image, tile, row in rows:
   148	                if image not in opened:
   149	                    opened[image] = Image.open(part_dir / image).convert("L")
   150	                    opened[image].load()
   151	                got = opened[image].crop(_rect(tile))
   152	                want = source.crop(_rect(row))
   153	                check.compared += 1
   154	                if got.tobytes() == want.tobytes():
   155	                    check.identical += 1
   156	                else:
   157	                    check.note(
   158	                        f"{row['name']} differs: composite {image}{_rect(tile)} "
   159	                        f"is not page {page}{_rect(row)}"
   160	                    )
   161	        for handle in opened.values():
   162	            handle.close()
   163	        for handle in images:
   164	            handle.close()
   165	    return check
   166	
   167	
   168	def _sample(wanted: Dict[int, List[Any]], sample: Optional[int]) -> Dict[int, List[Any]]:
   169	    """A spread of tiles across pages, or all of them.
   170	
   171	    Spread rather than the first N: the first N are one page, and a mapping that breaks on the
   172	    second composite would pass. Deterministic, so a failure can be reproduced.
   173	    """
   174	    if sample is None:
   175	        return wanted
   176	    pages = sorted(wanted)
   177	    if not pages:
   178	        return {}
   179	    per_page = max(1, sample // len(pages))
   180	    out: Dict[int, List[Any]] = {}
   181	    taken = 0
   182	    for page in pages:
   183	        rows = wanted[page][:per_page]
   184	        if rows:
   185	            out[page] = rows
   186	            taken += len(rows)
   187	        if taken >= sample:
   188	            break
   189	    return out
   190	
   191	
   192	def render_report(checks: Sequence[PartCheck]) -> str:
   193	    """What held and what did not, in the order a reader needs it."""
   194	    tiles = sum(c.tiles for c in checks)
   195	    compared = sum(c.compared for c in checks)
   196	    identical = sum(c.identical for c in checks)
   197	    bad = [c for c in checks if not c.ok]
   198	
   199	    lines = [
   200	        f"REPACK VERIFICATION over {len(checks)} parts",
   201	        "",
   202	        f"   tiles in manifests        {tiles:,}",
   203	        f"   tiles placed              {sum(c.placements for c in checks):,}",
   204	        f"   pixel-compared            {compared:,}",
   205	        f"   byte-identical            {identical:,}"
   206	        + (f"  ({identical / compared:.1%})" if compared else ""),
   207	        "",
   208	    ]
   209	    if not bad:
   210	        lines.append("   every check passed: no tile lost, none placed twice, none overlapping,")
   211	        lines.append("   and every compared crop is the same bytes as its source page.")
   212	        return "\n".join(lines)
   213	
   214	    lines.append(f"   {len(bad)} parts with problems:")
   215	    for c in bad:
   216	        lines.append(f"      part {c.part_no}: {len(c.problems)} problem(s)")
   217	        for problem in c.problems[:5]:
   218	            lines.append(f"         {problem}")
   219	        if len(c.problems) > 5:
   220	            lines.append(f"         ... and {len(c.problems) - 5} more")
   221	    return "\n".join(lines)
     1	"""The chain, per constituency, so that changing the AC number is the only change.
     2	
     3	    zip -> stage 1 (CPU: render, boxes, lines, repack, tesseract side-reads)
     4	        -> stage 2 (Cloud Vision over the composites, words mapped back to boxes)
     5	        -> a Parquet shard, appended to a manifest that accumulates across constituencies
     6	        -> reconciled against each part's own printed closing total
     7	
     8	Two properties are worth more than the code that provides them.
     9	
    10	**A killed run never pays twice.** Stage one is resumable because its output is on disk and
    11	``stage1.done`` can see it. Stage two is resumable because each part's rows are cached to
    12	``rows.jsonl`` the moment Vision answers -- before anything is aggregated, written or reconciled.
    13	Vision costs money and a crash between the API call and the shard would otherwise re-buy every
    14	image in the constituency.
    15	
    16	**Reconciliation is not optional and not silent.** Every part is scored against the roll's own
    17	printed ``মূল তালিকা`` total -- the only number here that this pipeline did not itself produce --
    18	and a part whose closing page could not be read is reported as *unmeasured* rather than counted
    19	as passing. Those are different claims and the difference is the whole value of the check.
    20	"""
    21	
    22	from __future__ import annotations
    23	
    24	import json
    25	import time
    26	from concurrent.futures import ProcessPoolExecutor, ThreadPoolExecutor, as_completed
    27	from dataclasses import dataclass, field
    28	from pathlib import Path
    29	from typing import Any, Callable, Dict, List, Optional, Sequence
    30	
    31	from assam_rolls import render
    32	
    33	from . import output, pages, stage1, stage2, vision
    34	
    35	#: Cached rows for one part, so a resumed run re-reads them instead of re-buying them.
    36	ROWS = "rows.jsonl"
    37	
    38	#: Concurrent Cloud Vision requests. The API allows 1,800 a minute and one composite takes about
    39	#: nine seconds, so this is nowhere near the service's limit -- it is chosen to stay well inside
    40	#: it while cutting the state's wait from ten days to under a day.
    41	VISION_WORKERS = 24
    42	
    43	
    44	@dataclass
    45	class ACRun:
    46	    """What one constituency cost and what it established."""
    47	
    48	    ac_no: int
    49	    parts: int = 0
    50	    #: How many parts the info pages say this constituency has. The one number that would have
    51	    #: caught AC101 shipping 113 of 210 the moment it happened, rather than an hour later when
    52	    #: somebody noticed a coverage figure of 173%.
    53	    parts_published: int = 0
    54	    boxes: int = 0
    55	    rows: int = 0
    56	    images_billed: int = 0
    57	    parts_measured: int = 0
    58	    parts_matching: int = 0
    59	    residuals: List[Dict[str, Any]] = field(default_factory=list)
    60	    #: Watermarked deletions detected, against what the roll's own arithmetic implies.
    61	    struck_off: Dict[str, Any] = field(default_factory=dict)
    62	    failed_parts: List[Dict[str, str]] = field(default_factory=list)
    63	    stage1_seconds: float = 0.0
    64	    stage2_seconds: float = 0.0
    65	    shard: str = ""
    66	    error: str = ""
    67	
    68	    @property
    69	    def cost(self) -> float:
    70	        return vision.cost(self.images_billed)
    71	
    72	    def as_manifest_entry(self) -> Dict[str, Any]:
    73	        return {
    74	            "rows": self.rows,
    75	            "parts": self.parts,
    76	            "parts_published": self.parts_published,
    77	            "parts_measured": self.parts_measured,
    78	            "parts_matching_roll": self.parts_matching,
    79	            "parts_failed": len(self.failed_parts),
    80	            "struck_off_detected": self.struck_off.get("detected"),
    81	            "struck_off_implied": self.struck_off.get("implied"),
    82	            "images_billed": self.images_billed,
    83	            "vision_usd": round(self.cost, 2),
    84	            "stage1_seconds": round(self.stage1_seconds, 1),
    85	            "stage2_seconds": round(self.stage2_seconds, 1),
    86	        }
    87	
    88	
    89	def prepare(
    90	    zip_path: Path,
    91	    work_dir: Path,
    92	    limit: Optional[int] = None,
    93	    workers: int = 4,
    94	    on_part: Optional[Callable[[stage1.PartPrep], None]] = None,
    95	) -> List[stage1.PartPrep]:
    96	    """Stage one over every part of one zip, skipping parts already prepared."""
    97	    refs = list(render.iter_zip_parts(zip_path))
    98	    if limit:
    99	        refs = refs[:limit]
   100	    work_dir.mkdir(parents=True, exist_ok=True)
   101	
   102	    todo = [r for r in refs if not stage1.done(work_dir, r.part_no)]
   103	    preps: List[stage1.PartPrep] = []
   104	    if todo:
   105	        with ProcessPoolExecutor(max_workers=workers) as pool:
   106	            futures = {
   107	                pool.submit(stage1.prepare_part, zip_path, ref.pdf_name, ref.part_no, work_dir): ref
   108	                for ref in todo
   109	            }
   110	            for future in as_completed(futures):
   111	                prep = future.result()
   112	                preps.append(prep)
   113	                if on_part:
   114	                    on_part(prep)
   115	    return preps
   116	
   117	
   118	def read(
   119	    work_dir: Path,
   120	    api_key: str,
   121	    parts: Optional[Sequence[int]] = None,
   122	    on_part: Optional[Callable[[int, int, int], None]] = None,
   123	    workers: int = VISION_WORKERS,
   124	) -> List[Dict[str, Any]]:
   125	    """Stage two over every prepared part, using cached rows where they exist.
   126	
   127	    The cache is written per part rather than per constituency because that is the unit of
   128	    money: a part read is a part paid for, and it should stay read.
   129	
   130	    Parts are read **concurrently**, because this stage does not compute anything -- it waits.
   131	    Measured sequentially: 8.7 seconds an image, a load average of 0.8 on 32 cores, and 239
   132	    hours for the state's 99,000 images. That is ten days of a machine being billed to hold a
   133	    socket open, more than the API calls themselves cost. Cloud Vision allows 1,800 requests a
   134	    minute; one at a time uses seven.
   135	
   136	    Threads rather than processes: the work is a network round trip, so the interpreter lock is
   137	    never the constraint, and each part writes only its own files.
   138	    """
   139	    wanted = set(parts) if parts else None
   140	    todo = []
   141	    for part_dir in sorted(work_dir.glob("part*")):
   142	        number = int(part_dir.name.replace("part", ""))
   143	        if wanted is not None and number not in wanted:
   144	            continue
   145	        todo.append((number, part_dir))
   146	
   147	    found: Dict[int, List[Dict[str, Any]]] = {}
   148	    errors: List[str] = []
   149	    unready: List[int] = []
   150	
   151	    def one(number: int, part_dir: Path) -> None:
   152	        cache = part_dir / ROWS
   153	        if cache.exists():
   154	            rows = [json.loads(line) for line in cache.read_text(encoding="utf-8").splitlines()]
   155	            billed = 0
   156	        else:
   157	            if not stage2.ready(part_dir):
   158	                # Never silent. A part prepared but unreadable is the shape AC101 took when it
   159	                # lost 97 parts, and a bare continue is what let it look like success.
   160	                unready.append(number)
   161	                return
   162	            result = stage2.read_part(part_dir, api_key)
   163	            if result.error:
   164	                errors.append(f"part {number}: {result.error}")
   165	                return
   166	            rows, billed = result.electors, result.images_billed
   167	            _write_rows(cache, rows)
   168	        found[number] = rows
   169	        if on_part:
   170	            on_part(number, len(rows), billed)
   171	
   172	    with ThreadPoolExecutor(max_workers=max(1, workers)) as pool:
   173	        for future in as_completed([pool.submit(one, n, d) for n, d in todo]):
   174	            future.result()
   175	
   176	    if unready:
   177	        raise RuntimeError(
   178	            f"{len(unready)} parts have stage-one metadata but no composites to read: "
   179	            f"{sorted(unready)[:8]}. They were prepared by a machine whose disk is gone; "
   180	            f"delete their part directories so they are prepared again."
   181	        )
   182	    if errors:
   183	        raise RuntimeError("; ".join(errors[:5]))
   184	    # Reassembled in part order. Concurrency decides when a part is read, never where its rows
   185	    # land, and a shard whose row order depends on scheduling is not reproducible.
   186	    return [row for number in sorted(found) for row in found[number]]
   187	
   188	
   189	def _write_rows(path: Path, rows: Sequence[Dict[str, Any]]) -> None:
   190	    """Atomically, so a kill mid-write cannot leave a half-part that looks complete."""
   191	    temporary = path.with_suffix(".jsonl.tmp")
   192	    temporary.write_text(
   193	        "".join(json.dumps(row, ensure_ascii=False) + "\n" for row in rows),
   194	        encoding="utf-8",
   195	    )
   196	    temporary.replace(path)
   197	
   198	
   199	def images_billed(work_dir: Path) -> int:
   200	    """What this constituency actually cost, counted from the composites on disk.
   201	
   202	    Counted from the images rather than accumulated from the runs, because a resumed run bills
   203	    nothing for the parts it skipped and the total would then shrink each time it was resumed.
   204	    """
   205	    return sum(len(stage2.composites(p)) for p in work_dir.glob("part*"))
   206	
   207	
   208	def reconcile(work_dir: Path, rows: Sequence[Dict[str, Any]]) -> Dict[str, Any]:
   209	    """Main-list rows against each part's own printed closing total.
   210	
   211	    Main list only. A part's supplements are counted separately on the closing page, so scoring
   212	    every row against that total makes a part with a supplement look over-extracted -- part 4
   213	    read 511 boxes against a printed 483 and the 28 were its supplement, correctly found.
   214	    """
   215	    main_by_part: Dict[int, int] = {}
   216	    for row in rows:
   217	        if row.get("roll_section", pages.Section.MAIN.value) == pages.Section.MAIN.value:
   218	            main_by_part[row["part_no"]] = main_by_part.get(row["part_no"], 0) + 1
   219	
   220	    measured = matching = 0
   221	    residuals: List[Dict[str, Any]] = []
   222	    for part_dir in sorted(work_dir.glob("part*")):
   223	        side_path = part_dir / "side.json"
   224	        if not side_path.exists():
   225	            continue
   226	        number = int(part_dir.name.replace("part", ""))
   227	        closing = stage1.read_side(side_path)["summary"]
   228	        if closing is None:
   229	            continue
   230	        measured += 1
   231	        got = main_by_part.get(number, 0)
   232	        if got == closing.total:
   233	            matching += 1
   234	        else:
   235	            residuals.append(
   236	                {
   237	                    "part_no": number,
   238	                    "main_rows": got,
   239	                    "roll_total": closing.total,
   240	                    "diff": got - closing.total,
   241	                }
   242	            )
   243	    return {"measured": measured, "matching": matching, "residuals": residuals}
   244	
   245	
   246	def struck_off_check(
   247	    work_dir: Path, rows: Sequence[Dict[str, Any]], published: Dict[int, int]
   248	) -> Dict[str, Any]:
   249	    """What the roll's own arithmetic says was struck off, against what was detected.
   250	
   251	    A second route to the same number, sharing no code with the first. The detector reads a
   252	    watermark off the pixels; this derives the count from two numbers the publisher printed on
   253	    different pages and that this pipeline did not produce::
   254	
   255	        info-page net = main-list total + additions - struck off
   256	
   257	    So ``main + additions - net`` is how many entries should carry the stamp. Over the first 19
   258	    parts of AC1 that is 514, and part 4's 14 was confirmed by hand.
   259	
   260	    This matters because the watermark is the one field with no other check on it. A detector
   261	    that silently found nothing would look exactly like a roll with no deletions, and every
   262	    row would be published as a live elector. ``published`` maps part number to the info page's
   263	    ``electors_total``, from ``dataset/parts.jsonl.gz``.
   264	    """
   265	    counted: Dict[int, Dict[str, int]] = {}
   266	    for row in rows:
   267	        part = counted.setdefault(row["part_no"], {"main": 0, "extra": 0, "deleted": 0})
   268	        if row.get("roll_section", pages.Section.MAIN.value) == pages.Section.MAIN.value:
   269	            part["main"] += 1
   270	        else:
   271	            part["extra"] += 1
   272	        if row.get("deleted"):
   273	            part["deleted"] += 1
   274	
   275	    per_part: List[Dict[str, Any]] = []
   276	    for part_no, found in sorted(counted.items()):
   277	        net = published.get(part_no)
   278	        if net is None:
   279	            continue
   280	        implied = found["main"] + found["extra"] - net
   281	        per_part.append(
   282	            {
   283	                "part_no": part_no,
   284	                "detected": found["deleted"],
   285	                "implied": implied,
   286	                "diff": found["deleted"] - implied,
   287	            }
   288	        )
   289	    return {
   290	        "parts": len(per_part),
   291	        "detected": sum(p["detected"] for p in per_part),
   292	        "implied": sum(p["implied"] for p in per_part),
   293	        "per_part": per_part,
   294	    }
   295	
   296	
   297	def published_totals(ac_no: int, dataset: Path = Path("dataset/parts.jsonl.gz")) -> Dict[int, int]:
   298	    """Each part's published net elector count, from the info pages already extracted."""
   299	    import gzip
   300	
   301	    if not dataset.exists():
   302	        return {}
   303	    out: Dict[int, int] = {}
   304	    with gzip.open(dataset, "rt", encoding="utf-8") as handle:
   305	        for line in handle:
   306	            row = json.loads(line)
   307	            if row.get("ac_no") == ac_no and row.get("electors_total") is not None:
   308	                out[row["part_no"]] = row["electors_total"]
   309	    return out
   310	
   311	
   312	def run_ac(
   313	    zip_path: Path,
   314	    work_dir: Path,
   315	    api_key: str,
   316	    shard_dir: Path = output.SHARD_DIR,
   317	    manifest: Path = output.MANIFEST,
   318	    limit: Optional[int] = None,
   319	    workers: int = 4,
   320	    vision_workers: int = VISION_WORKERS,
   321	    log: Optional[Callable[[str], None]] = None,
   322	) -> ACRun:
   323	    """One constituency, end to end. The AC number is the only thing that changes."""
   324	    say = log or (lambda _message: None)
   325	    ac_no = _ac_number(zip_path)
   326	    run = ACRun(ac_no=ac_no)
   327	
   328	    started = time.time()
   329	    preps = prepare(
   330	        zip_path,
   331	        work_dir,
   332	        limit=limit,
   333	        workers=workers,
   334	        on_part=lambda p: say(
   335	            f"    stage1 part {p.part_no:<5} {p.boxes:>5} boxes  {p.composites} images"
   336	            + (f"  FAILED {p.error}" if p.error else "")
   337	        ),
   338	    )
   339	    run.stage1_seconds = time.time() - started
   340	    run.failed_parts = [{"part": str(p.part_no), "error": p.error} for p in preps if p.error]
   341	
   342	    prepared = [p for p in sorted(work_dir.glob("part*")) if stage2.ready(p)]
   343	    run.parts = len(prepared)
   344	    run.boxes = sum(
   345	        len(stage2.placements_of(p).get(c.name, [])) for p in prepared for c in stage2.composites(p)
   346	    )
   347	    say(f"    {run.parts} parts prepared, {run.boxes:,} boxes, {images_billed(work_dir)} images")
   348	
   349	    started = time.time()
   350	    try:
   351	        rows = read(
   352	            work_dir,
   353	            api_key,
   354	            workers=vision_workers,
   355	            on_part=lambda n, count, billed: say(
   356	                f"    stage2 part {n:<5} {count:>5} rows"
   357	                + ("  (cached)" if not billed else f"  {billed} images")
   358	            ),
   359	        )
   360	    except RuntimeError as exc:
   361	        run.error = str(exc)
   362	        return run
   363	    run.stage2_seconds = time.time() - started
   364	    run.rows = len(rows)
   365	    run.images_billed = images_billed(work_dir)
   366	
   367	    # The shard is named from the archive; every row's ac_no comes from the PDF filename inside
   368	    # it. They agree on real data, and if they ever do not, one of the two is wrong and the shard
   369	    # would be filed under a constituency it does not contain. Cheap to check, silent if not.
   370	    inside = {row["ac_no"] for row in rows}
   371	    if inside and inside != {ac_no}:
   372	        run.error = f"{zip_path.name} is AC{ac_no} but its rows carry {sorted(inside)}"
   373	        return run
   374	
   375	    # Against the info pages, which are not this pipeline's work. A constituency short of its
   376	    # own published part count has lost whole parts, and that is not a quality question to be
   377	    # noticed later -- it is a failed run.
   378	    published = published_totals(ac_no)
   379	    run.parts_published = len(published)
   380	    if published and run.parts < len(published) * 0.99:
   381	        run.error = (
   382	            f"extracted {run.parts} parts of {len(published)} published -- "
   383	            f"{len(published) - run.parts} are missing"
   384	        )
   385	        return run
   386	
   387	    found = reconcile(work_dir, rows)
   388	    run.parts_measured = found["measured"]
   389	    run.parts_matching = found["matching"]
   390	    run.residuals = found["residuals"]
   391	    run.struck_off = struck_off_check(work_dir, rows, published_totals(ac_no))
   392	
   393	    path = output.write_shard(rows, ac_no, directory=shard_dir)
   394	    run.shard = path.name
   395	    # Its own file, not a shared manifest: four machines writing one JSON lose each other's
   396	    # entries with nothing raised. electors status merges them back.
   397	    output.write_entry(ac_no, path, run.as_manifest_entry(), directory=shard_dir)
   398	    output.update_manifest(ac_no, path, run.as_manifest_entry(), manifest=manifest)
   399	    return run
   400	
   401	
   402	def _ac_number(zip_path: Path) -> int:
   403	    """From the archive's own name, e.g. ``AC17_ASM.zip`` -> 17."""
   404	    digits = "".join(c for c in zip_path.stem.split("_")[0] if c.isdigit())
   405	    if not digits:
   406	        raise ValueError(f"cannot read an AC number from {zip_path.name}")
   407	    return int(digits)
   408	
   409	
   410	def render_report(runs: Sequence[ACRun]) -> str:
   411	    """The three things worth reading: what it found, what it cost, what it reconciles to."""
   412	    ok = [r for r in runs if not r.error]
   413	    rows = sum(r.rows for r in ok)
   414	    images = sum(r.images_billed for r in ok)
   415	    measured = sum(r.parts_measured for r in ok)
   416	    matching = sum(r.parts_matching for r in ok)
   417	
   418	    short = [r for r in ok if r.parts_published and r.parts < r.parts_published]
   419	    lines = [
   420	        f"RUN over {len(runs)} constituencies",
   421	        "",
   422	        f"   rows                  {rows:,}",
   423	        f"   parts                 {sum(r.parts for r in ok):,}",
   424	        f"   images billed         {images:,}",
   425	        f"   Cloud Vision          ${vision.cost(images):.2f}",
   426	        "",
   427	        f"   reconciled            {matching}/{measured} parts exact against their printed total",
   428	    ]
   429	    unmeasured = sum(r.parts for r in ok) - measured
   430	    if unmeasured:
   431	        lines.append(f"   unmeasured            {unmeasured} parts, closing page unreadable")
   432	    detected = sum(r.struck_off.get("detected", 0) for r in ok)
   433	    implied = sum(r.struck_off.get("implied", 0) for r in ok)
   434	    if implied or detected:
   435	        lines.append(
   436	            f"   struck off            {detected:,} detected, {implied:,} implied by the "
   437	            f"roll's own arithmetic"
   438	        )
   439	        if implied and detected < implied * 0.8:
   440	            lines.append("   ^^ the watermark is being missed; those rows publish as live electors")
   441	
   442	    for r in short:
   443	        lines.append(f"   AC{r.ac_no} SHORT: {r.parts} parts of {r.parts_published} published")
   444	
   445	    residuals = [(r.ac_no, d) for r in ok for d in r.residuals]
   446	    if residuals:
   447	        lines.append("")
   448	        lines.append("   parts not matching:")
   449	        for ac_no, item in residuals[:12]:
   450	            lines.append(
   451	                f"      AC{ac_no} part {item['part_no']}: {item['main_rows']} rows "
   452	                f"against {item['roll_total']} printed ({item['diff']:+d})"
   453	            )
   454	        if len(residuals) > 12:
   455	            lines.append(f"      ... and {len(residuals) - 12} more")
   456	    failed = [(r.ac_no, f) for r in ok for f in r.failed_parts]
   457	    if failed:
   458	        lines.append("")
   459	        lines.append(f"   {len(failed)} parts failed in stage one:")
   460	        for ac_no, item in failed[:8]:
   461	            lines.append(f"      AC{ac_no} part {item['part']}: {item['error']}")
   462	    for r in runs:
   463	        if r.error:
   464	            lines.append(f"   AC{r.ac_no} FAILED: {r.error}")
   465	    return "\n".join(lines)
     1	"""Stage one: everything the CPU can do, and nothing that costs money.
     2	
     3	The pipeline splits at the only expensive step. This stage renders each part, finds the boxes
     4	geometrically from the ruled lines, finds the text lines inside them, reads the three fields
     5	tesseract is good enough for -- the EPIC, the section header and the closing totals -- and packs
     6	the four labelled lines into composites for Cloud Vision.
     7	
     8	Everything it produces is what stage two needs and nothing more:
     9	
    10	- **composites**, the images Vision is billed for. Repacking cuts a rendered page from 15.5 MP
    11	  to 30% of that, which is 3.3x fewer images: $345 for the state against about $105.
    12	- **placements**, every tile's rectangle inside its composite. Vision answers in the composite's
    13	  coordinates and a word has to come back to the box it was cut from; without this, stage two
    14	  would have to re-derive the geometry and could silently disagree with the geometry that
    15	  produced the image.
    16	- **a manifest**, one row per tile carrying ac, part, page, box, band, rectangle, section and
    17	  the source sha, so a reading can be put in the right row and traced to exact source bytes.
    18	- **side reads**, the EPIC and serial per box and the part's printed closing total, which is the
    19	  only number in the source that the extracted rows can be measured against.
    20	
    21	It costs about 142 ms of CPU per box -- 985 core-hours for all 126 constituencies, roughly $8 of
    22	spot CPU or five days on a laptop -- and nothing at all in API charges.
    23	"""
    24	
    25	from __future__ import annotations
    26	
    27	import json
    28	import time
    29	from dataclasses import dataclass, field
    30	from pathlib import Path
    31	from typing import Any, Dict, List, Optional, Sequence
    32	
    33	from assam_rolls import render, schema
    34	
    35	from . import crops, extract, pages, repack, summary, vision, vision_part
    36	
    37	#: Bumped whenever stage one changes what it writes, because ``done`` is keyed on it.
    38	#:
    39	#: The concern is data, not code. ``done`` proved a part had been prepared, never *by what*, so
    40	#: a resume happily served side reads produced before a fix -- twice in one evening. Once when
    41	#: composites on disk let a rerun skip parts whose EPICs were still at 62%, and again when a new
    42	#: instance pulled that same output back out of the bucket and reported "resumed with 111 parts
    43	#: already prepared". Both were caught by reading a log line, which is not a control.
    44	#:
    45	#: ``extract.PIPELINE_VERSION`` does exactly this for the row cache and is why that cache has
    46	#: never had the same problem.
    47	#:
    48	#: 2.0.0 -- the EPIC and serial are read from their own cells rather than one strip pass, and a
    49	#:          struck-off entry's status code is recorded.
    50	#: 2.1.0 -- a section marker must be a whole word outside the station-name field, a partial
    51	#:          page's second row is no longer rejected by a gutter estimated from header rules,
    52	#:          and all of a part's columns are built with ink deciding which hold an elector.
    53	#:          Together these recovered 625 rows in AC1 that reconciliation had reported missing.
    54	#: 2.2.0 -- a status code must be one of the five the roll defines in its own legend.
    55	#: 2.3.0 -- a closing page tesseract could not read is kept, so stage two can spend on it.
    56	STAGE1_VERSION = "2.3.0"
    57	
    58	
    59	@dataclass
    60	class PartPrep:
    61	    """What stage one produced for one part, and what it could not."""
    62	
    63	    ac_no: int
    64	    part_no: int
    65	    pages: int = 0
    66	    elector_pages: int = 0
    67	    boxes: int = 0
    68	    main_boxes: int = 0
    69	    supplement_boxes: int = 0
    70	    composites: int = 0
    71	    unknown_pages: List[int] = field(default_factory=list)
    72	    summary_total: Optional[int] = None
    73	    seconds: float = 0.0
    74	    error: str = ""
    75	
    76	    @property
    77	    def matches_roll(self) -> Optional[bool]:
    78	        """Whether the **main-list** boxes equal the part's own printed total.
    79	
    80	        Main list only. The closing page totals ``মূল তালিকা`` -- the main roll -- and a part's
    81	        supplements are counted separately, so comparing every box against it makes a part with
    82	        supplements look over-extracted. Part 4 read 511 boxes against a printed 483 and the 28
    83	        were its supplement, correctly found.
    84	
    85	        ``None`` when the closing page could not be read -- reported as unmeasured rather than
    86	        scored against a number that was never established.
    87	        """
    88	        if self.summary_total is None:
    89	            return None
    90	        return self.main_boxes == self.summary_total
    91	
    92	
    93	def prepare_part(
    94	    zip_path: Path,
    95	    pdf_name: str,
    96	    part_no: int,
    97	    out_dir: Path,
    98	    dpi: int = extract.DPI,
    99	) -> PartPrep:
   100	    """Render one part and write everything stage two will need for it."""
   101	    started = time.time()
   102	    meta = schema.parse_source_filename(pdf_name) or {}
   103	    prep = PartPrep(ac_no=meta.get("ac_no", 0), part_no=part_no)
   104	    part_dir = out_dir / f"part{part_no:04d}"
   105	
   106	    try:
   107	        import tempfile
   108	
   109	        pdf_bytes = render.read_pdf_bytes(zip_path, pdf_name)
   110	        sha = render.sha256_bytes(pdf_bytes)
   111	        with tempfile.TemporaryDirectory() as tmp:
   112	            images = vision_part.rasterize(dpi)(pdf_bytes, Path(tmp))
   113	            prep.pages = len(images)
   114	            entries, side = vision_part.tiles_for(images)
   115	            prep.unknown_pages = side["unknown"]
   116	            prep.elector_pages = len(side["pages"])
   117	            prep.boxes = len(entries)
   118	            for _, _, key in entries:
   119	                if side["pages"][key[0]]["section"] is pages.Section.MAIN:
   120	                    prep.main_boxes += 1
   121	                else:
   122	                    prep.supplement_boxes += 1
   123	            if side["summary"] is not None:
   124	                prep.summary_total = side["summary"].total
   125	
   126	            part_dir.mkdir(parents=True, exist_ok=True)
   127	            budget = int(vision.MAX_PIXELS * vision.PIXEL_MARGIN)
   128	            placements: Dict[str, Any] = {}
   129	            written: List[crops.Crop] = []
   130	            for number, batch in enumerate(repack.batches(entries, budget)):
   131	                composite, placed = repack.compose(batch)
   132	                # Keyed by the filename itself, not a stem the reader has to know how to
   133	                # complete. The first version keyed on "composite000" and the verifier went
   134	                # looking for a file of that name.
   135	                name = f"composite{number:03d}.png"
   136	                composite.save(part_dir / name, format="PNG", optimize=True)
   137	                placements[name] = [
   138	                    {
   139	                        "page": tile.key[0],
   140	                        "box_row": tile.key[1],
   141	                        "box_col": tile.key[2],
   142	                        "left": tile.left,
   143	                        "top": tile.top,
   144	                        "right": tile.right,
   145	                        "bottom": tile.bottom,
   146	                    }
   147	                    for tile in placed
   148	                ]
   149	                prep.composites += 1
   150	                for _, rect, key in batch:
   151	                    page_side = side["pages"][key[0]]
   152	                    written.append(
   153	                        crops.Crop(
   154	                            part=part_no,
   155	                            page=key[0],
   156	                            row=key[1],
   157	                            column=key[2],
   158	                            path=part_dir / name,
   159	                            band=None,
   160	                            left=rect[0],
   161	                            top=rect[1],
   162	                            right=rect[2],
   163	                            bottom=rect[3],
   164	                            ac_no=prep.ac_no,
   165	                            section=page_side["section"].value,
   166	                            source_zip=zip_path.name,
   167	                            source_pdf=pdf_name,
   168	                            pdf_sha256=sha,
   169	                        )
   170	                    )
   171	
   172	            _write(part_dir / "placements.json", placements)
   173	            # The closing page tesseract could not read, left for stage two to buy a reading of.
   174	            if side.get("unread_summary") is not None:
   175	                side["unread_summary"].save(
   176	                    part_dir / "summary_page.png", format="PNG", optimize=True
   177	                )
   178	            write_side(part_dir / "side.json", side)
   179	            crops.write_manifest(written, part_dir, append=False)
   180	            for image in images:
   181	                image.close()
   182	    except Exception as exc:  # a bad part must not stop the constituency
   183	        prep.error = f"{type(exc).__name__}: {exc}"
   184	    prep.seconds = time.time() - started
   185	    return prep
   186	
   187	
   188	def _write(path: Path, payload: Any) -> None:
   189	    path.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
   190	
   191	
   192	def write_side(path: Path, side: Dict[str, Any]) -> None:
   193	    """The CPU's own readings, in a form that survives the trip to disk unchanged.
   194	
   195	    A round trip, not a summary. The first version wrote a flattened digest -- EPICs, section
   196	    values, a total -- and stage two would have had to re-render the part to recover the sex
   197	    breakdown and the unreadable pages, which is the re-rendering the split exists to avoid.
   198	    """
   199	    _write(
   200	        path,
   201	        {
   202	            "pages": {
   203	                str(number): {
   204	                    "section": page["section"].value,
   205	                    "recognised": page["recognised"],
   206	                    "boxes": {f"{k[1]},{k[2]}": read for k, read in page["boxes"].items()},
   207	                }
   208	                for number, page in side["pages"].items()
   209	            },
   210	            # Preserved, never re-stamped. Stage two rewrites this file when it buys a closing
   211	            # total, and stamping the current version there would mark output produced by older
   212	            # stage-one code as fresh -- the exact failure done() exists to prevent.
   213	            "stage1_version": side.get("stage1_version") or STAGE1_VERSION,
   214	            "unknown": side["unknown"],
   215	            "summary": (
   216	                None
   217	                if side["summary"] is None
   218	                else {
   219	                    "male": side["summary"].male,
   220	                    "female": side["summary"].female,
   221	                    "third": side["summary"].third,
   222	                    "total": side["summary"].total,
   223	                    "scale": side["summary"].scale,
   224	                }
   225	            ),
   226	        },
   227	    )
   228	
   229	
   230	def read_side(path: Path) -> Dict[str, Any]:
   231	    """``write_side`` inverted, giving back exactly what ``tiles_for`` produced."""
   232	    raw = json.loads(path.read_text(encoding="utf-8"))
   233	    return {
   234	        "pages": {
   235	            int(number): {
   236	                "section": pages.Section(page["section"]),
   237	                "recognised": page["recognised"],
   238	                "boxes": {
   239	                    (int(number), int(k.split(",")[0]), int(k.split(",")[1])): read
   240	                    for k, read in page["boxes"].items()
   241	                },
   242	            }
   243	            for number, page in raw["pages"].items()
   244	        },
   245	        "stage1_version": raw.get("stage1_version", ""),
   246	        "unknown": raw["unknown"],
   247	        "summary": (None if raw["summary"] is None else summary.RollSummary(**raw["summary"])),
   248	    }
   249	
   250	
   251	def done(out_dir: Path, part_no: int) -> bool:
   252	    """Whether this part is already prepared, so a run can be resumed.
   253	
   254	    Requires the manifest *and* the placements: a part interrupted between writing composites
   255	    and writing where the tiles are cannot be read by stage two, and half-finished work that
   256	    looks finished is worse than work that was never started.
   257	
   258	    And requires the side reads to have been written by *this* version of stage one. Without
   259	    that, a rerun after a fix serves the output the fix was meant to replace, and the resulting
   260	    constituency is a silent mixture of two vintages with nothing in the data to tell them
   261	    apart. Re-preparing a part costs a few seconds of CPU; not re-preparing it costs the fix.
   262	    """
   263	    part_dir = out_dir / f"part{part_no:04d}"
   264	    if not (part_dir / crops.MANIFEST).exists() or not (part_dir / "placements.json").exists():
   265	        return False
   266	    # And the composites themselves. They are not synced to the bucket -- they are cheap to
   267	    # rebuild and would be a terabyte for the state -- so a machine that resumes from the bucket
   268	    # gets a part's metadata without its images. Every other test passed, this part was skipped
   269	    # as prepared, and stage two then skipped it again for having nothing to read: AC101 shipped
   270	    # 113 of its 210 parts and reported no error at all.
   271	    #
   272	    # done() and stage2.ready() must not disagree about what a finished part is.
   273	    if not any(part_dir.glob("composite*.png")):
   274	        return False
   275	    side = part_dir / "side.json"
   276	    if not side.exists():
   277	        return False
   278	    try:
   279	        return json.loads(side.read_text(encoding="utf-8")).get("stage1_version") == STAGE1_VERSION
   280	    except (ValueError, OSError):
   281	        return False
   282	
   283	
   284	def summarise(preps: Sequence[PartPrep]) -> Dict[str, Any]:
   285	    """What the run established, in the terms the next stage and the bill are both in."""
   286	    ok = [p for p in preps if not p.error]
   287	    measured = [p for p in ok if p.matches_roll is not None]
   288	    return {
   289	        "parts": len(preps),
   290	        "failed": len(preps) - len(ok),
   291	        "pages": sum(p.pages for p in ok),
   292	        "boxes": sum(p.boxes for p in ok),
   293	        "main_boxes": sum(p.main_boxes for p in ok),
   294	        "supplement_boxes": sum(p.supplement_boxes for p in ok),
   295	        "composites": sum(p.composites for p in ok),
   296	        "parts_measured": len(measured),
   297	        "parts_matching_roll": sum(1 for p in measured if p.matches_roll),
   298	        "parts_unmeasured": [p.part_no for p in ok if p.matches_roll is None],
   299	        "residuals": [
   300	            {
   301	                "part_no": p.part_no,
   302	                "main_boxes": p.main_boxes,
   303	                "supplement_boxes": p.supplement_boxes,
   304	                "roll_total": p.summary_total,
   305	                "diff": p.main_boxes - (p.summary_total or 0),
   306	            }
   307	            for p in measured
   308	            if not p.matches_roll
   309	        ],
   310	        "unknown_pages": {p.part_no: p.unknown_pages for p in ok if p.unknown_pages},
   311	        "seconds": sum(p.seconds for p in preps),
   312	        "vision_cost": vision.cost(sum(p.composites for p in ok)),
   313	    }
     1	"""Stage two: the only step that costs money, and nothing else.
     2	
     3	Stage one already rendered the part, found the boxes, read the EPICs and packed the text into
     4	composites. This stage submits those composites to Cloud Vision and puts the words back in the
     5	rows they came from. It never opens the source PDF.
     6	
     7	That is the whole point of the split. ``vision_part.read_repacked`` does both halves in one pass,
     8	which means re-running Vision -- after a parser change, or with a second engine -- re-renders 121
     9	pages of PDF and re-runs tesseract over every box to get back to pixels that are already sitting
    10	on disk. Here the composites are the input, so a second reading costs the API call and nothing
    11	else.
    12	
    13	The join is the load-bearing part. Vision answers in each **composite's** coordinates, and a word
    14	in tile 200 has to come back to box 200 of page 14. ``placements.json`` holds every tile's
    15	rectangle and ``repack.words_for`` assigns by that rectangle on both axes, so two tiles side by
    16	side never share a word even when Vision groups them into one visual line. That the rectangles
    17	are right is not assumed: ``electors.verify`` compares every tile's pixels against the source
    18	page, and on the first five parts of AC1 all 2,964 were byte-identical.
    19	"""
    20	
    21	from __future__ import annotations
    22	
    23	import json
    24	from pathlib import Path
    25	from typing import Any, Callable, Dict, List, Optional, Sequence, Tuple
    26	
    27	from assam_rolls import schema
    28	
    29	from . import crops, extract, repack, stage1, vision, vision_part
    30	
    31	
    32	def composites(part_dir: Path) -> List[Path]:
    33	    """The images stage one left, in the order it wrote them."""
    34	    return sorted(part_dir.glob("composite*.png"))
    35	
    36	
    37	def placements_of(part_dir: Path) -> Dict[str, List[repack.Placed]]:
    38	    """Each composite's tiles, back as the objects the mapper expects.
    39	
    40	    Rebuilt rather than re-derived. Re-deriving the layout here would let stage two disagree with
    41	    the image stage one actually produced -- and the disagreement would look like a reading error,
    42	    not a geometry error, because the words would come back plausible and misfiled.
    43	    """
    44	    raw = json.loads((part_dir / "placements.json").read_text(encoding="utf-8"))
    45	    return {
    46	        image: [
    47	            repack.Placed(
    48	                key=(tile["page"], tile["box_row"], tile["box_col"]),
    49	                left=tile["left"],
    50	                top=tile["top"],
    51	                right=tile["right"],
    52	                bottom=tile["bottom"],
    53	            )
    54	            for tile in tiles
    55	        ]
    56	        for image, tiles in raw.items()
    57	    }
    58	
    59	
    60	def identity(part_dir: Path) -> Dict[str, Any]:
    61	    """Which part this is, taken from the manifest rather than from the directory name.
    62	
    63	    A directory can be moved or renamed; the manifest carries the source filename and its sha, so
    64	    the identity travels with the data and a row can still be traced to exact source bytes.
    65	    """
    66	    manifest = crops.read_manifest(part_dir)
    67	    if not manifest:
    68	        raise ValueError(f"{part_dir} has an empty manifest")
    69	    row = next(iter(manifest.values()))
    70	    return {
    71	        "ac_no": row["ac_no"],
    72	        "part_no": row["part_no"],
    73	        "source_zip": row.get("source_zip", ""),
    74	        "source_pdf": row["source_pdf"],
    75	        "pdf_sha256": row["pdf_sha256"],
    76	    }
    77	
    78	
    79	def read_part(
    80	    part_dir: Path,
    81	    api_key: str,
    82	    annotate: Optional[Callable[[Sequence[Any]], Sequence[Any]]] = None,
    83	) -> extract.PartResult:
    84	    """One prepared part through Vision, as rows.
    85	
    86	    ``annotate`` is injectable so the mapping can be tested without spending anything: the join
    87	    is the part that can be wrong, and it should not take an API key to check it.
    88	    """
    89	    from PIL import Image
    90	
    91	    who = identity(part_dir)
