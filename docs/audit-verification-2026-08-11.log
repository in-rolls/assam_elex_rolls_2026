  1041	def cmd_status(args: argparse.Namespace) -> int:
  1042	    """One verdict per constituency, from the shards and the roll's own numbers.
  1043	
  1044	    Recomputed from the data rather than read out of a manifest, so it cannot report a pass that
  1045	    the current shards do not support.
  1046	    """
  1047	    import collections
  1048	    import gzip
  1049	
  1050	    from . import reconcile, stage1
  1051	
  1052	    published: Dict[int, int] = collections.Counter()
  1053	    male: Dict[int, int] = collections.Counter()
  1054	    female: Dict[int, int] = collections.Counter()
  1055	    info = Path(args.info)
  1056	    if info.exists():
  1057	        with gzip.open(info, "rt", encoding="utf-8") as handle:
  1058	            for line in handle:
  1059	                row = json.loads(line)
  1060	                published[row["ac_no"]] += 1
  1061	                male[row["ac_no"]] += row.get("electors_male") or 0
  1062	                female[row["ac_no"]] += row.get("electors_female") or 0
  1063	
  1064	    verdicts = []
  1065	    for shard in sorted(Path(args.shards).glob("AC*.parquet")):
  1066	        ac_no = int(shard.stem[2:])
  1067	        rows = output.read_shard(shard)
  1068	        totals: Dict[int, int] = {}
  1069	        boxes: Dict[int, int] = {}
  1070	        work = Path(args.work) / f"AC{ac_no:03d}"
  1071	        for part_dir in sorted(work.glob("part*")):
  1072	            number = int(part_dir.name.replace("part", ""))
  1073	            side_path = part_dir / "side.json"
  1074	            if side_path.exists():
  1075	                closing = stage1.read_side(side_path)["summary"]
  1076	                if closing is not None:
  1077	                    totals[number] = closing.total
  1078	            manifest = part_dir / "manifest.jsonl"
  1079	            if manifest.exists():
  1080	                boxes[number] = sum(1 for _ in manifest.open(encoding="utf-8"))
  1081	        verdicts.append(
  1082	            reconcile.judge(
  1083	                ac_no,
  1084	                rows,
  1085	                published.get(ac_no, 0),
  1086	                totals,
  1087	                male.get(ac_no, 0),
  1088	                female.get(ac_no, 0),
  1089	                boxes or None,
  1090	            )
  1091	        )
  1092	
  1093	    if not verdicts:
  1094	        print(f"no shards under {args.shards}", file=sys.stderr)
  1095	        return 1
  1096	    print(reconcile.render(verdicts))
  1097	    return 0 if all(v.ok for v in verdicts) else 1
