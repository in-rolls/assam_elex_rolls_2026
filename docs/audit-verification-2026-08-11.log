   284	
   285	
   286	def write_manifest(written: Sequence[Crop], out_dir: Path, append: bool = True) -> Path:
   287	    """One row per crop, written beside the crops by whoever cut them.
   288	
   289	    The filename carries the join key, but not the rectangle, the section or the source sha --
   290	    and a reading cannot be put in the right row without the section, because serials restart at
   291	    1 in every supplement. A manifest generated separately from the images is a manifest that can
   292	    disagree with them, so this is called from the same loop that writes the PNGs.
   293	    """
   294	    import json
   295	
   296	    out_dir.mkdir(parents=True, exist_ok=True)
   297	    path = out_dir / MANIFEST
   298	    with path.open("a" if append else "w", encoding="utf-8") as handle:
   299	        for crop in written:
   300	            handle.write(json.dumps(crop.as_row(), ensure_ascii=False) + "\n")
   301	    return path
   302	
   303	
   304	def read_manifest(out_dir: Path) -> Dict[str, Dict[str, Any]]:
   305	    """The manifest keyed by crop name, which is how readings are joined back."""
   306	    import json
   307	
   308	    path = out_dir / MANIFEST
   309	    if not path.exists():
   310	        return {}
   311	    rows: Dict[str, Dict[str, Any]] = {}
   312	    for line in path.read_text(encoding="utf-8").splitlines():
   313	        if not line.strip():
   314	            continue
   315	        row = json.loads(line)
   316	        if row["name"] in rows:
   317	            # Keys collide only if the writer used something that is not a position. Raised
   318	            # rather than overwritten: silently keeping the last row is how 873 tiles became 3.
   319	            raise ValueError(f"duplicate manifest key {row['name']!r} in {path}")
   320	        rows[row["name"]] = row
   321	    return rows
   322	
   323	
   324	def readings_to_arm(readings: dict, arm: str = "dots.ocr") -> List:
   325	    """Turn ``{crop name: terse text}`` into the arms :mod:`electors.resolution` compares.
   326	
   327	    The readings come back from whatever GPU ran them as one JSON object. Parsed here with the
   328	    *same* parser Vision's output goes through, because two readers of one format is the bug
   329	    that put the elector's own name in the relation field, and comparing engines through two
   330	    different parsers would measure the parsers.
   331	    """
   332	    from . import resolution, second_pass
   333	
   334	    by_part: dict = {}
   335	    for name, text in readings.items():
   336	        key = key_of(name)
   337	        if not key:
   338	            continue
   339	        part, page, row, column = key
   340	        found = second_pass.Reading(str(text or "")).fields()
   341	        by_part.setdefault(part, {})[(page, row, column)] = {
   342	            "name": found.get("name", ""),
   343	            "age": found.get("age"),
   344	            "house": found.get("house_no", ""),
   345	            "sex": found.get("sex", ""),
   346	        }
   347	    return [
   348	        resolution.ArmResult(arm=arm, part=part, boxes=boxes)
   349	        for part, boxes in sorted(by_part.items())
   350	    ]
