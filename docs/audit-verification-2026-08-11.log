     1	"""Proving the repack is right, rather than assuming it.
     2	
     3	The composites are what Cloud Vision is billed for and what every extracted row derives from, so
     4	"the packing is correct" cannot rest on having looked at a contact sheet. Two failures matter and
     5	neither announces itself:
     6	
     7	- **a tile lost**, so an elector who is plainly printed never reaches the output
     8	- **a tile misplaced**, so a name comes back attributed to somebody else's row
     9	
    10	Both are checkable exactly, because stage one records two rectangles for every tile: where it was
    11	cut from the page (``manifest.jsonl``) and where it landed in the composite (``placements.json``).
    12	Cropping the composite at the second must give **byte-identical pixels** to cropping the
    13	re-rendered page at the first. Nothing about that is statistical -- it either matches or it names
    14	the tile that does not.
    15	"""
    16	
    17	from __future__ import annotations
    18	
    19	import json
    20	from dataclasses import dataclass, field
    21	from pathlib import Path
    22	from typing import Any, Dict, List, Optional, Sequence, Tuple
    23	
    24	from assam_rolls import render
    25	
    26	from . import crops, extract, vision_part
