    28	
    29	@dataclass
    30	class PartCheck:
    31	    """What one part's repack survived, and what it did not."""
    32	
    33	    part_no: int
    34	    tiles: int = 0
    35	    placements: int = 0
    36	    compared: int = 0
    37	    identical: int = 0
    38	    problems: List[str] = field(default_factory=list)
    39	
    40	    @property
    41	    def ok(self) -> bool:
    42	        return not self.problems
    43	
    44	    def note(self, problem: str) -> None:
    45	        self.problems.append(problem)
    46	
    47	
    48	def _rect(row: Dict[str, Any]) -> Tuple[int, int, int, int]:
    49	    return (row["left"], row["top"], row["right"], row["bottom"])
    50	
    51	
    52	def _overlaps(a: Dict[str, Any], b: Dict[str, Any]) -> bool:
    53	    return not (
    54	        a["right"] <= b["left"]
    55	        or b["right"] <= a["left"]
    56	        or a["bottom"] <= b["top"]
    57	        or b["bottom"] <= a["top"]
    58	    )
