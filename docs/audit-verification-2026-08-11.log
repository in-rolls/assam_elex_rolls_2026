  2659	class TestRepack:
  2660	    """Tiles packed to cut the bill, and words found again afterwards.
  2661	
  2662	    Vision bills per image and 70% of a page is white space, borders and empty photo boxes. The
  2663	    danger is not that a tighter image reads worse -- it is that a word comes back attributed to
  2664	    the wrong box, which is a plausible row with nothing raised.
  2665	    """
  2666	
  2667	    @staticmethod
  2668	    def _tiles(n, w=776, h=200):
  2669	        from PIL import Image
  2670	
  2671	        page = Image.new("L", (w, h * n), "white")
  2672	        return [(page, (0, i * h, w, (i + 1) * h), (3, i, 0)) for i in range(n)]
  2673	
  2674	    def test_every_tile_gets_a_rectangle_in_the_composite(self):
  2675	        image, placed = repack.compose(self._tiles(7), columns=3)
  2676	        assert len(placed) == 7
  2677	        assert image.width == 3 * 776 + 2 * repack.GUTTER
  2678	        for tile in placed:
  2679	            assert tile.width == 776 and tile.height == 200
  2680	
  2681	    def test_a_word_comes_back_to_the_tile_it_was_placed_in(self):
  2682	        """The page-offset bug one level down: unshifted, a word lands in whichever tile sits at
  2683	        that height and the row is wrong with nothing to show for it."""
  2684	        image, placed = repack.compose(self._tiles(9), columns=3)
