   110	def measured_coverage(rows: Sequence[Dict[str, Any]], totals: Dict[int, int]) -> Check:
   111	    """How many parts carry a printed total at all -- how much of the check above applies.
   112	
   113	    Reported apart from the result of that check, because 205 of 205 matching means something
   114	    very different when 205 is every part than when it is four fifths of them.
   115	    """
   116	    parts = len({r["part_no"] for r in rows})
   117	    return Check(
   118	        "every part measurable",
   119	        bool(parts) and len(totals) >= parts,
   120	        f"{len(totals)} of {parts} parts have a printed total",
