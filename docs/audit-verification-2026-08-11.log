  1100	def cmd_verify(args: argparse.Namespace) -> int:
  1101	    """Structure first, then pixels. No API calls."""
  1102	    from . import verify
  1103	
  1104	    stage_dir = Path(args.stage1_dir)
  1105	    parts = sorted(stage_dir.glob("part*"))
  1106	    if not parts:
  1107	        print(f"no parts under {stage_dir}", file=sys.stderr)
  1108	        return 1
  1109	
  1110	    by_part = {}
  1111	    if args.zip:
  1112	        zip_path = Path(args.zip)
  1113	        by_part = {p.part_no: p.pdf_name for p in render.iter_zip_parts(zip_path)}
  1114	
  1115	    checks = []
  1116	    for part_dir in parts:
  1117	        check = verify.check_structure(part_dir)
  1118	        if args.zip and check.ok and check.part_no in by_part:
  1119	            verify.check_pixels(
  1120	                Path(args.zip),
  1121	                by_part[check.part_no],
  1122	                part_dir,
  1123	                check,
  1124	                sample=None if args.all or args.sample == 0 else args.sample,
  1125	            )
  1126	        checks.append(check)
  1127	        mark = "ok" if check.ok else f"{len(check.problems)} PROBLEM(S)"
  1128	        print(
  1129	            f"  part {check.part_no:<4} {check.tiles:>5} tiles  "
  1130	            f"{check.identical}/{check.compared} identical  {mark}"
  1131	        )
  1132	
  1133	    print()
  1134	    print(verify.render_report(checks))
  1135	    return 0 if all(c.ok for c in checks) else 1
