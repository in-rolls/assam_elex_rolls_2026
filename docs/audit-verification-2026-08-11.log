    33	from assam_rolls import render, schema
    34	
    35	from . import crops, extract, pages, repack, summary, vision, vision_part
    36	
    37	#: Bumped whenever stage one changes what it writes, because ``done`` is keyed on it.
    38	#:
    39	#: The concern is data, not code. ``done`` proved a part had been prepared, never *by what*, so
    40	#: a resume happily served side reads produced before a fix -- twice in one evening. Once when
    41	#: composites on disk let a rerun skip parts whose EPICs were still at 62%, and again when a new
    42	#: instance pulled that same output back out of the bucket and reported "resumed with 111 parts
    43	#: already prepared". Both were caught by reading a log line, which is not a control.
    44	#:
    45	#: ``extract.PIPELINE_VERSION`` does exactly this for the row cache and is why that cache has
    46	#: never had the same problem.
    47	#:
    48	#: 2.0.0 -- the EPIC and serial are read from their own cells rather than one strip pass, and a
    49	#:          struck-off entry's status code is recorded.
    50	#: 2.1.0 -- a section marker must be a whole word outside the station-name field, a partial
    51	#:          page's second row is no longer rejected by a gutter estimated from header rules,
    52	#:          and all of a part's columns are built with ink deciding which hold an elector.
    53	#:          Together these recovered 625 rows in AC1 that reconciliation had reported missing.
    54	#: 2.2.0 -- a status code must be one of the five the roll defines in its own legend.
    55	#: 2.3.0 -- a closing page tesseract could not read is kept, so stage two can spend on it.
    56	STAGE1_VERSION = "2.3.0"
