   136	    if not (got_m + got_f) or not (male + female):
   137	        return Check("sex ratio", False, "no sex values to compare", external=True)
   138	    ours, theirs = got_m / (got_m + got_f), male / (male + female)
   139	    return Check(
   140	        "sex ratio",
