    93	def prepare_part(
    94	    zip_path: Path,
    95	    pdf_name: str,
    96	    part_no: int,
    97	    out_dir: Path,
    98	    dpi: int = extract.DPI,
    99	) -> PartPrep:
   100	    """Render one part and write everything stage two will need for it."""
   101	    started = time.time()
   102	    meta = schema.parse_source_filename(pdf_name) or {}
   103	    prep = PartPrep(ac_no=meta.get("ac_no", 0), part_no=part_no)
   104	    part_dir = out_dir / f"part{part_no:04d}"
   105	
   106	    try:
   107	        import tempfile
   108	
   109	        pdf_bytes = render.read_pdf_bytes(zip_path, pdf_name)
   110	        sha = render.sha256_bytes(pdf_bytes)
   111	        with tempfile.TemporaryDirectory() as tmp:
   112	            images = vision_part.rasterize(dpi)(pdf_bytes, Path(tmp))
   113	            prep.pages = len(images)
   114	            entries, side = vision_part.tiles_for(images)
   115	            prep.unknown_pages = side["unknown"]
   116	            prep.elector_pages = len(side["pages"])
   117	            prep.boxes = len(entries)
   118	            for _, _, key in entries:
   119	                if side["pages"][key[0]]["section"] is pages.Section.MAIN:
   120	                    prep.main_boxes += 1
   121	                else:
   122	                    prep.supplement_boxes += 1
   123	            if side["summary"] is not None:
   124	                prep.summary_total = side["summary"].total
   125	
   126	            part_dir.mkdir(parents=True, exist_ok=True)
   127	            budget = int(vision.MAX_PIXELS * vision.PIXEL_MARGIN)
   128	            placements: Dict[str, Any] = {}
   129	            written: List[crops.Crop] = []
   130	            for number, batch in enumerate(repack.batches(entries, budget)):
   131	                composite, placed = repack.compose(batch)
   132	                # Keyed by the filename itself, not a stem the reader has to know how to
   133	                # complete. The first version keyed on "composite000" and the verifier went
   134	                # looking for a file of that name.
   135	                name = f"composite{number:03d}.png"
   136	                composite.save(part_dir / name, format="PNG", optimize=True)
   137	                placements[name] = [
   138	                    {
   139	                        "page": tile.key[0],
   140	                        "box_row": tile.key[1],
   141	                        "box_col": tile.key[2],
   142	                        "left": tile.left,
   143	                        "top": tile.top,
   144	                        "right": tile.right,
   145	                        "bottom": tile.bottom,
   146	                    }
   147	                    for tile in placed
   148	                ]
   149	                prep.composites += 1
   150	                for _, rect, key in batch:
   151	                    page_side = side["pages"][key[0]]
   152	                    written.append(
   153	                        crops.Crop(
   154	                            part=part_no,
   155	                            page=key[0],
   156	                            row=key[1],
   157	                            column=key[2],
   158	                            path=part_dir / name,
   159	                            band=None,
   160	                            left=rect[0],
   161	                            top=rect[1],
   162	                            right=rect[2],
   163	                            bottom=rect[3],
   164	                            ac_no=prep.ac_no,
   165	                            section=page_side["section"].value,
   166	                            source_zip=zip_path.name,
   167	                            source_pdf=pdf_name,
   168	                            pdf_sha256=sha,
   169	                        )
   170	                    )
   171	
   172	            _write(part_dir / "placements.json", placements)
   173	            # The closing page tesseract could not read, left for stage two to buy a reading of.
   174	            if side.get("unread_summary") is not None:
   175	                side["unread_summary"].save(
   176	                    part_dir / "summary_page.png", format="PNG", optimize=True
   177	                )
   178	            write_side(part_dir / "side.json", side)
   179	            crops.write_manifest(written, part_dir, append=False)
   180	            for image in images:
   181	                image.close()
   182	    except Exception as exc:  # a bad part must not stop the constituency
   183	        prep.error = f"{type(exc).__name__}: {exc}"
   184	    prep.seconds = time.time() - started
   185	    return prep
