    59	@dataclass
    60	class PartPrep:
    61	    """What stage one produced for one part, and what it could not."""
    62	
    63	    ac_no: int
    64	    part_no: int
    65	    pages: int = 0
    66	    elector_pages: int = 0
    67	    boxes: int = 0
    68	    main_boxes: int = 0
    69	    supplement_boxes: int = 0
    70	    composites: int = 0
    71	    unknown_pages: List[int] = field(default_factory=list)
    72	    summary_total: Optional[int] = None
    73	    seconds: float = 0.0
    74	    error: str = ""
    75	
    76	    @property
    77	    def matches_roll(self) -> Optional[bool]:
    78	        """Whether the **main-list** boxes equal the part's own printed total.
    79	
    80	        Main list only. The closing page totals ``মূল তালিকা`` -- the main roll -- and a part's
    81	        supplements are counted separately, so comparing every box against it makes a part with
    82	        supplements look over-extracted. Part 4 read 511 boxes against a printed 483 and the 28
    83	        were its supplement, correctly found.
    84	
    85	        ``None`` when the closing page could not be read -- reported as unmeasured rather than
    86	        scored against a number that was never established.
    87	        """
    88	        if self.summary_total is None:
    89	            return None
    90	        return self.main_boxes == self.summary_total
