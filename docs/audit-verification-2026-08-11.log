    90	def rows_against_printed(
    91	    rows: Sequence[Dict[str, Any]], totals: Dict[int, int], main: str = "main"
    92	) -> Check:
    93	    """Main-list rows against each part's own printed closing total.
    94	
    95	    Main list only: supplements are counted separately on the closing page, so scoring every row
    96	    against that total makes a part with a supplement look over-extracted.
    97	    """
    98	    counted: Dict[int, int] = collections.Counter(
    99	        r["part_no"] for r in rows if (r.get("roll_section") or main) == main
   100	    )
