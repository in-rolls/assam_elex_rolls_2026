   889	def cmd_stage1(args: argparse.Namespace) -> int:
   890	    """Render, find the boxes, repack them, and read what the CPU can. No API calls."""
   891	    from . import stage1
   892	
   893	    zip_path = Path(args.zip)
   894	    if not zip_path.exists():
   895	        print(f"no such zip: {zip_path}", file=sys.stderr)
   896	        return 1
   897	    render.require_poppler()
   898	
   899	    parts = [p for p in render.iter_zip_parts(zip_path)]
   900	    if args.limit:
   901	        parts = parts[: args.limit]
   902	    if not parts:
   903	        print(f"no recognisable part PDFs in {zip_path}", file=sys.stderr)
   904	        return 1
   905	
   906	    ac_no = parts[0].ac_no
   907	    out_dir = Path(args.out) / f"AC{ac_no:03d}"
   908	    out_dir.mkdir(parents=True, exist_ok=True)
   909	    already = sum(1 for p in parts if stage1.done(out_dir, p.part_no))
   910	    log = timing.setup(f"stage1-AC{ac_no:03d}")
   911	    log.info(
   912	        "%s: %d parts, AC %d, %d workers%s -> %s",
   913	        zip_path.name,
   914	        len(parts),
   915	        ac_no,
   916	        args.workers,
   917	        f", {already} already prepared" if already else "",
   918	        out_dir,
   919	    )
   920	    clock = timing.RunClock(total=len(parts), workers=args.workers)
   921	
   922	    preps: List[Any] = []
   923	    with ProcessPoolExecutor(max_workers=args.workers) as pool:
   924	        payload = [(str(zip_path), p.pdf_name, p.part_no, str(out_dir), args.dpi) for p in parts]
   925	        for row in (f.result() for f in as_completed([pool.submit(_one_prep, i) for i in payload])):
   926	            preps.append(stage1.PartPrep(**{k: v for k, v in row.items() if k != "cached"}))
   927	            clock.record(row.get("seconds"), bool(row.get("cached")))
   928	            log.info(
   929	                "%s | %s boxes, %s composites%s",
   930	                clock.progress(
   931	                    row["part_no"],
   932	                    row["boxes"],
   933	                    row.get("seconds"),
   934	                    bool(row.get("cached")),
   935	                ),
   936	                f"{row['boxes']:,}",
   937	                row["composites"],
   938	                f"  ERROR {row['error']}" if row["error"] else "",
   939	            )
   940	
   990	                "run 'gcloud auth application-default login', or set VISION_API_KEY, "
   991	                "or pass --prepare-only to stop before Vision",
   992	                file=sys.stderr,
   993	            )
   994	            return 1
   995	    render.require_poppler()
   996	
   997	    runs = []
   998	    for name in args.zips:
   999	        zip_path = Path(name)
  1000	        if not zip_path.exists():
  1001	            print(f"no such zip: {zip_path}", file=sys.stderr)
  1002	            return 1
  1003	        ac_no = runner._ac_number(zip_path)
  1004	        work = Path(args.work) / f"AC{ac_no:03d}"
  1005	        print(f"\nAC{ac_no}  {zip_path.name}")
  1006	
  1007	        if args.prepare_only:
  1008	            runner.prepare(
  1009	                zip_path,
  1010	                work,
  1011	                limit=args.limit or None,
  1012	                workers=args.workers,
  1013	                on_part=lambda p: print(
  1014	                    f"    stage1 part {p.part_no:<5} {p.boxes:>5} boxes  {p.composites} images"
  1015	                    + (f"  FAILED {p.error}" if p.error else "")
  1016	                ),
  1017	            )
  1018	            images = runner.images_billed(work)
  1019	            print(f"    prepared. {images} images would cost ${vision.cost(images):.2f}")
  1020	            continue
  1021	
  1022	        found = runner.run_ac(
  1023	            zip_path,
  1024	            work,
  1025	            api_key,
  1026	            shard_dir=Path(args.shards),
  1027	            manifest=Path(args.manifest),
  1028	            limit=args.limit or None,
  1029	            workers=args.workers,
  1030	            log=print,
  1031	        )
  1032	        runs.append(found)
  1033	        print(f"    {found.rows:,} rows -> {found.shard}  ${found.cost:.2f}")
  1034	
  1035	    if runs:
  1036	        print()
  1037	        print(runner.render_report(runs))
  1038	    return 0 if all(not r.error for r in runs) else 1
