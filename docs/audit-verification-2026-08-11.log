    74	def parts_complete(rows: Sequence[Dict[str, Any]], published: int) -> Check:
    75	    """Every part the info pages publish is present.
    76	
    77	    The check AC101 needed. It shipped 113 of its 210 parts, reconciled every one of them, and
    78	    reported success -- because reconciliation only scores parts that reached the shard, so a
    79	    part that vanished entirely was invisible to it. A check that cannot see absence is not a
    80	    completeness check.
    81	    """
    82	    found = len({r["part_no"] for r in rows})
    83	    return Check(
    84	        "parts complete",
    85	        found == published,
    86	        f"{found} of {published} published parts",
    87	    )
